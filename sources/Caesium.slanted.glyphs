{
code = "sub fi.noccmp by f i;
sub fl.noccmp by f l;

sub D by D.prop.wp1;
sub M by M.prop.wp2;
sub O by O.prop.wp2;
sub Q by Q.prop.wp2;
sub W by W.prop.wp2;
sub i by i.prop.wm2;
sub j by j.prop.wm2;
sub m by m.prop.wp2;
sub r by r.prop.wm1;
sub t by t.prop.wm2;
sub w by w.prop.wp2;
sub space by space.pwid;
sub H.ss02 by H.ss02.prop.wp1;
sub I.ss02 by I.ss02.prop.wm2;
sub J.ss02 by J.ss02.prop.wm2;
sub N.ss02 by N.ss02.prop.wp1;
sub Q.ss02 by Q.ss02.prop.wp2;

@intoT = [a a.ss02 c e f g g.ss02 i.prop.wm2 j.prop.wm2 M.prop.wp2 n o p p.ss02 q r.prop.wm1 s u v W.prop.wp2 x y y.ss02 z z.ss02];
@puncLow = [period comma underscore];
@puncMidLow = [colon semicolon ratio];
pos T @intoT -48;
enum pos [@intoT A] T -48;
enum pos [F P T] A -48;
pos T [@puncLow @puncMidLow] -96;
enum pos [F P] @puncLow -96;
enum pos [F P] @puncMidLow -48;
enum pos [V seven] @puncLow -48;";
tag = pwid;
},
{
code = "@case = [@digit @Uppercase];
sub @case colon' @case by ratio;
sub @digit x' by x.digit;
sub x' @digit by x.digit;
sub [zero zero.dotted] b' [zero one zero.dotted] by b.digit;

sub underscore' underscore by underscore.underscore;
";
tag = calt;
},
{

sub Q.ss01 by Q.ss01.prop.wp2;

@intoT = [a a.ss01 c e f g g.ss01 i.prop.wm2 j.prop.wm2 M.prop.wp2 n o p p.ss01 q r.prop.wm1 s u v W.prop.wp2 x y y.ss01 z z.ss02];
@puncLow = [period comma underscore];
@puncMidLow = [colon semicolon ratio];
pos T @intoT -48;
